# Not sure what a .gitignore is?
# See: https://git-scm.com/docs/gitignore

# These are directly copied from Jekyll's first-party docs on `.gitignore` files:
# https://jekyllrb.com/tutorials/using-jekyll-with-bundler/#commit-to-source-control

# Ignore the default location of the built site, and caches and metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# Ignore OS/editor metadata and temporary Office lock files
.DS_Store
~$*

# Ignore local Python development artifacts
.venv/
.coverage
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Ignore transient migration dry-run summaries; retain named reports under reports/.
generated/migration/*.json

# Ignore LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nlo
*.out
*.synctex.gz
*.toc

# Adapter output - generated files
_data_generated/
publication/
